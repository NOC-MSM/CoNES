#!/bin/bash
# Lightweight script to set up NEMO
set -euo pipefail

display_usage() {
   cat <<EOF

  Auto-Config: NEMO in Singularity
  ***************************************

  usage: ${0##*/} -p path_to_install

  flags:
    -p  full path to where nemo/xios will be installed

EOF
   exit 1
}

# Quick help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    display_usage
fi

# Ensure required tools exist
for cmd in git svn curl jq tar make; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Required command '$cmd' not found in PATH" >&2
        exit 1
    fi
done

# Read container namelist (must exist)
if [[ ! -f /input_files/NEMO_in ]]; then
    echo "Missing /input_files/NEMO_in" >&2
    exit 1
fi
. /input_files/NEMO_in

# Parse arguments
WORK_DIR=""
while getopts "p:" opt; do
  case "${opt}" in
    p) WORK_DIR="${OPTARG}";;
    :) printf "missing argument for -%s\n" "$OPTARG" >&2; display_usage; exit 1;;
    \?) printf "illegal option: -%s\n" "$OPTARG" >&2; display_usage; exit 1;;
  esac
done

# Validate required arguments
if [[ -z "${WORK_DIR}" ]]; then
    echo "Missing required arguments."
    display_usage
fi

if [[ "${WORK_DIR:0:1}" != "/" ]]; then
  echo "WORK_DIR must be an absolute path" >&2
  exit 1
fi

# Create and move to work dir
mkdir -p "$WORK_DIR"
export CONFIG_DIR="$WORK_DIR/nemo/cfgs/NEMO"
export XIOS_DIR="$WORK_DIR/xios"

cd "$WORK_DIR"

# Validate requested NEMO version
case "${NEMO_VER:-}" in
  4.2|4.2.3|5.0.1|main)
    echo "NEMO Version ${NEMO_VER} will be checked out"
    ;;
  *)
    echo "NEMO Version not recognised: ${NEMO_VER:-}" >&2
    echo "Versions available: 4.2.3, 4.2, 5.0.1, main" >&2
    exit 1
    ;;
esac

echo "Checking out NEMO repository"
case "${NEMO_VER}" in
  4.2)
    git clone --filter=blob:none --no-checkout --depth 1 --sparse --branch branch_4.2 https://forge.nemo-ocean.eu/nemo/nemo.git nemo
    cd nemo
    git sparse-checkout add /makenemo /mk /src /cfgs/SHARED /cfgs/ref_cfgs.txt /tests/demo_cfgs.txt /ext
        ;;
  4.2.3|5.0.1|main)
    git clone --filter=blob:none --no-checkout --depth 1 --sparse --branch "$NEMO_VER" https://forge.nemo-ocean.eu/nemo/nemo.git nemo
    cd nemo
    git sparse-checkout add /makenemo /mk /src /cfgs/SHARED /cfgs/ref_cfgs.txt /tests/demo_cfgs.txt /ext
        ;;
esac

# Is a NEMO configuration required
PROJECT_ID=24
if [[ "${CFGS:-}" != "NONE" ]]; then
    # Fetch cfg names
    CFG_ARRAY=($(curl -s "https://forge.nemo-ocean.eu/api/v4/projects/$PROJECT_ID/repository/tree?ref=$NEMO_VER&path=cfgs" \
                | jq -r '.[] | select(.type=="tree") | .name'))
    CFG=false
    for cfg in "${CFG_ARRAY[@]:-}"; do
        if [[ "$cfg" == "$CFGS" ]]; then
            CFG=true
            git sparse-checkout add "/cfgs/$CFGS"
            break
        fi
    done

    CFG_TEST_ARRAY=($(curl -s "https://forge.nemo-ocean.eu/api/v4/projects/$PROJECT_ID/repository/tree?ref=$NEMO_VER&path=tests" \
                | jq -r '.[] | select(.type=="tree") | .name'))
    TEST=false
    for cfg in "${CFG_TEST_ARRAY[@]:-}"; do
        if [[ "$cfg" == "$CFGS" ]]; then
            TEST=true
            git sparse-checkout add "/tests/$CFGS"
            break
        fi
    done

    if [[ "${CFG}" == "false" || "${TEST}" == "false" ]]; then
        echo "NEMO configuration, $CFGS, does not exist" >&2
        exit 1
    fi
fi

git checkout

# If a new CONFIG is being created setup the directory structure else link to $CFGS
if [[ "${CFGS:-}" != "NONE" ]]; then
    if [[ "${CFG}" == "true" ]]; then
        ln -sfn "$WORK_DIR/nemo/cfgs/NEMO" "$WORK_DIR/nemo/cfgs/$CFGS"
        CMPTS=$(grep -w "^$CFGS" "$WORK_DIR/nemo/cfgs/work_cfgs.txt" | cut -d' ' -f2- || true)
        echo "NEMO $CMPTS" >> "$WORK_DIR/nemo/cfgs/work_cfgs.txt"
    else
        ln -sfn "$WORK_DIR/nemo/cfgs/NEMO" "$WORK_DIR/nemo/tests/$CFGS"
        CMPTS=$(grep -w "^$CFGS" "$WORK_DIR/nemo/tests/work_cfgs.txt" | cut -d' ' -f2- || true)
        echo "NEMO $CMPTS" >> "$WORK_DIR/nemo/cfgs/demo_cfgs.txt"
    fi
else
    mkdir -p "$CONFIG_DIR/EXPREF"
    echo "NEMO $NEMO_CMPTS" >> "$WORK_DIR/nemo/cfgs/work_cfgs.txt"
    echo "bld::tool::fppkeys $CPP_KEYS" > "$CONFIG_DIR/cpp_NEMO.fcm"
    tar -xzf /input_files/MY_SRC.tar.gz -C "$CONFIG_DIR"
fi

# Checkout and compile XIOS
cd "$WORK_DIR"
case "${XIOS_VER:-}" in
  2)
    svn co http://forge.ipsl.jussieu.fr/ioserver/svn/XIOS2/trunk xios
    cd xios
    cp /input_files/arch/xios/arch* ./arch || true
    ;;
  3)
    svn co http://forge.ipsl.jussieu.fr/ioserver/svn/XIOS3/trunk xios
    cd xios
    cp /input_files/arch/xios/arch* ./arch || true
    ;;
  *)
    echo "XIOS Version not recognised: ${XIOS_VER:-}" >&2
    echo "Versions available: 2 or 3" >&2
    exit 1
    ;;
esac

echo "Compiling xios"
if [[ -x "./make_xios" ]]; then
    ./make_xios --full --prod --arch singularity --netcdf_lib netcdf4_par -j 8
else
    echo "make_xios not found or not executable in xios directory" >&2
    exit 1
fi

# Check XIOS compiled
if [[ ! -f "$XIOS_DIR/bin/xios_server.exe" ]]; then
    echo "XIOS build failed: $XIOS_DIR/bin/xios_server.exe not found" >&2
    exit 1
fi

# Compile NEMO
cd "$WORK_DIR/nemo"
cp /input_files/arch/nemo/arch* ./arch

echo "Compiling NEMO"
./makenemo -m singularity -r NEMO -j 16

cd "$CONFIG_DIR/EXP00"

# Tidy up and remove unnecessary files
cp "$XIOS_DIR/bin/xios_server.exe" ./
rm -f nemo
if [[ -f "$CONFIG_DIR/BLD/bin/nemo.exe" ]]; then
    cp "$CONFIG_DIR/BLD/bin/nemo.exe" nemo
fi
rm -rf "$CONFIG_DIR/BLD" "$CONFIG_DIR/WORK" "$WORK_DIR/nemo/src" "$XIOS_DIR"