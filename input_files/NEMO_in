# Check that VERSION is 4.2.3, branch_4.2, 5.0.1 or main
NEMO_VER=4.2
# Check that VERSION is 2 or 3    
XIOS_VER=2
# NEMO configuration to compile.
# If "NONE" read NEMO_CMPTS, CPP_KEYS and MY_SRC
CFGS="NONE"  
# Which NEMO components to build OCE/ICE/TOP etc
NEMO_CMPTS="OCE ICE"
# Compiler keys
CPP_KEYS="key_xios key_qco key_si3"
# Read MY_SRC.tar.gz from inputs directory [true|false]            
MY_SRC="false"
# Which MPI implementation to use [MPICH|OMPI]
# If empty and using GH actions, both will be built
MPI="MPICH"
# Which communication framework to use [UCX|OFI]
# If empty and using GH actions, both will be built
COMM="UCX"   